source/main.i: source/main.cc.i
.PHONY : source/main.i

# target to preprocess a source file
source/main.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_1d.g.dir/build.make CMakeFiles/laplacian_1d.g.dir/source/main.cc.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_2d.g.dir/build.make CMakeFiles/laplacian_2d.g.dir/source/main.cc.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_3d.g.dir/build.make CMakeFiles/laplacian_3d.g.dir/source/main.cc.i
.PHONY : source/main.cc.i

source/main.s: source/main.cc.s
.PHONY : source/main.s

# target to generate assembly for a file
source/main.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_1d.g.dir/build.make CMakeFiles/laplacian_1d.g.dir/source/main.cc.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_2d.g.dir/build.make CMakeFiles/laplacian_2d.g.dir/source/main.cc.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/laplacian_3d.g.dir/build.make CMakeFiles/laplacian_3d.g.dir/source/main.cc.s
.PHONY : source/main.cc.s

